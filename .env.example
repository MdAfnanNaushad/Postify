# ==============================================================================
# POSTIFY — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit real secrets or credentials to version control.
# In production on Render, set these variables in the Render Dashboard Environment tab.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Server Configuration
# ------------------------------------------------------------------------------
# Runtime environment: 'development', 'production', or 'test'
NODE_ENV=development

# Port to listen on (Render supplies its own dynamic PORT automatically)
PORT=5000

# Host network interface to bind (use 0.0.0.0 for containerized / Render environments)
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Database Configuration (MongoDB Atlas in Production)
# ------------------------------------------------------------------------------
# Local development default: mongodb://127.0.0.1:27017/miniproject
# Production (Render): Use MongoDB Atlas connection string with your database user & password:
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/postify?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/miniproject

# ------------------------------------------------------------------------------
# Authentication & Session Security
# ------------------------------------------------------------------------------
# JWT signing secret. In production, Postify REFUSES to start if this is missing,
# insecure, shorter than 32 characters, or contains default placeholders.
# Generate a secure 32+ character key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_must_be_32_chars_minimum

# Token lifespan (e.g., '7d', '24h')
JWT_EXPIRES_IN=7d

# Cookie SameSite attribute ('lax' recommended for web applications with email links)
COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# Domains, CORS & Public URLs
# ------------------------------------------------------------------------------
# URL where client is accessed. Used for CORS allowlist and social preview redirects.
# Local development: http://localhost:5173
# Production (Render): https://your-service-name.onrender.com (or custom domain)
CLIENT_URL=http://localhost:5173

# Canonical base URL for OpenGraph social meta tags, sitemaps, and crawler previews
CANONICAL_APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Persistent Media & Storage
# ------------------------------------------------------------------------------
# Upload directory path. Defaults to ./public/images/uploads.
# In Render, if using a Persistent Disk mounted at /var/data/uploads, set:
# UPLOADS_DIR=/var/data/uploads
UPLOADS_DIR=

# ------------------------------------------------------------------------------
# Email Provider (Resend) — Weekly Developer Digest
# ------------------------------------------------------------------------------
# Resend API key (starts with re_). Required for live email delivery.
# If omitted or unconfigured, in-app digests are created without sending emails.
RESEND_API_KEY=re_your_resend_api_key_here

# Verified sender email domain configured in your Resend account
# e.g., digest@postify.dev or notifications@yourdomain.com
RESEND_FROM_EMAIL=digest@yourdomain.com

# Sender display name shown in developer inboxes
RESEND_FROM_NAME=Postify Weekly Digest
